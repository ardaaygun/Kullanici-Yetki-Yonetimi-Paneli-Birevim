<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BİREVİM</title>

    <!-- Yerel webp Favicon -->
    <link rel="icon" type="image/webp" href="~/images/icon.webp" />

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <!-- FontAwesome İkonları -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
            /* --- FLOATING LABEL BEYAZ KUTU SIFIRLAMA --- */
            .form-floating > label,
            .form-floating > .form-control:focus ~ label,
            .form-floating > .form-control:not(:placeholder-shown) ~ label {
                background-color: transparent !important;
                background: transparent !important;
            }

            /* --- TARAYICI OTOMATİK DOLDURMA (AUTOFILL) & İKON SIFIRLAMA --- */
            input:-webkit-autofill,
            input:-webkit-autofill:hover,
            input:-webkit-autofill:focus,
            input:-webkit-autofill:active {
                -webkit-box-shadow: 0 0 0 1000px #221515 inset !important;
                -webkit-text-fill-color: #ffffff !important;
                caret-color: #ffffff !important;
                transition: background-color 50000s ease-in-out 0s;
            }

            input::-webkit-credentials-auto-fill-button,
            input::-webkit-contacts-auto-fill-button,
            input::-webkit-autofill-preview-image {
                display: none !important;
                visibility: hidden !important;
                pointer-events: none !important;
            }

            /* Ekranın Taşmasını Önleme */
            html, body {
                height: 100vh;
                margin: 0;
                padding: 0;
                overflow: hidden;
            }

            /* Arka Plan Hero Section */
            .hero-section {
                background: linear-gradient(rgba(0,0,0,0.1), rgba(0,0,0,0.1)), url('/images/hero-bg.webp');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                height: 100vh;
                width: 100vw;
                color: #fff;
                position: relative;
            }

            /* Header Bar Şeridi */
            .custom-navbar {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                z-index: 100;
                background: linear-gradient(180deg, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 100%);
                padding: 16px 0;
            }

            /* Logo Görseli Stilleri */
            .site-logo {
                height: 42px;
                width: auto;
                filter: brightness(0) invert(1);
                transition: transform 0.3s ease, filter 0.3s ease;
            }

                .site-logo:hover {
                    transform: scale(1.05);
                }

            .brand-logo-container:hover .site-logo {
                opacity: 0.9;
            }

            /* Giriş Yap Butonu Stili */
            .btn-login {
                background-color: rgba(255, 255, 255, 0.15);
                color: #ffffff !important;
                border: 1px solid rgba(255, 255, 255, 0.4);
                padding: 8px 20px;
                border-radius: 30px;
                font-weight: 600;
                font-size: 13px;
                text-decoration: none;
                backdrop-filter: blur(5px);
                transition: all 0.3s ease;
                display: inline-block;
            }

                .btn-login:hover {
                    background-color: #ffffff;
                    color: #111111 !important;
                    border-color: #ffffff;
                    box-shadow: 0 4px 15px rgba(255, 255, 255, 0.2);
                }

            /* Glassmorphism Sol Kart */
            .glass-register-card {
                background: rgba(15, 15, 15, 0.45);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border: 1px solid rgba(255, 255, 255, 0.15);
                border-radius: 20px;
                box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
                transition: all 0.4s ease;
                max-width: 420px;
            }

            /* Floating Label & Custom Input Stilleri */
            .form-floating > .custom-glass-input {
                background: rgba(255, 255, 255, 0.08) !important;
                border: 1px solid rgba(255, 255, 255, 0.2) !important;
                color: #fff !important;
                border-radius: 10px !important;
                height: calc(2.8rem + 2px) !important;
                line-height: 1.1 !important;
                font-size: 14px;
            }

            .form-floating > label {
                color: rgba(255, 255, 255, 0.6) !important;
                padding-top: 0.6rem !important;
                font-size: 13px;
            }

            .custom-glass-input:focus {
                background: rgba(255, 255, 255, 0.15) !important;
                border-color: #ffffff !important;
                box-shadow: 0 0 15px rgba(255, 255, 255, 0.2) !important;
            }

            .form-floating > .form-control:focus ~ label,
            .form-floating > .form-control:not(:placeholder-shown) ~ label {
                color: #ffffff !important;
                opacity: 0.85;
            }

            /* Şifre İkonu */
            .toggle-password {
                right: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: rgba(255, 255, 255, 0.6);
                cursor: pointer;
                z-index: 10;
                transition: color 0.3s ease;
            }

                .toggle-password:hover {
                    color: #ffffff;
                }

            /* Custom Checkbox */
            .custom-checkbox {
                background-color: rgba(255, 255, 255, 0.1);
                border-color: rgba(255, 255, 255, 0.3);
                cursor: pointer;
            }

                .custom-checkbox:checked {
                    background-color: #ffffff;
                    border-color: #ffffff;
                }

            /* Submit Butonu ve Hover Efekti */
            .btn-glass-submit {
                background: #ffffff;
                color: #111111;
                border-radius: 10px;
                letter-spacing: 0.5px;
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                justify-content: center;
                border: none;
            }

                /* Submit Butonu Hover Durumu */
                .btn-glass-submit:hover {
                    background: #ffffff !important;
                    color: #e30613 !important; /* Yazı rengini kırmızı yapar */
                    transform: translateY(-2px);
                    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
                }

                    /* Hover Sırasında İkon ve Yazı Renginin Birlikte Değişmesi İçin */
                    .btn-glass-submit:hover span,
                    .btn-glass-submit:hover i {
                        color: #e30613 !important; /* İçindeki yazı ve oku kırmızı yapar */
                    }

                    .btn-glass-submit:hover .transition-icon {
                        transform: translateX(5px);
                    }

            .transition-icon {
                transition: transform 0.3s ease;
            }

            /* Bootstrap Floating Label Arka Planını Kesin Olarak Sıfırlama */
            .form-floating > label,
            .form-floating > .form-control:focus ~ label,
            .form-floating > .form-control:not(:placeholder-shown) ~ label,
            .form-floating > .form-select ~ label {
                background-color: transparent !important;
                background: none !important;
            }

                /* Label kayarken oluşan beyaz psödo (::after) elemanını silme */
                .form-floating > .form-control:focus ~ label::after,
                .form-floating > .form-control:not(:placeholder-shown) ~ label::after {
                    background-color: transparent !important;
                    background: none !important;
                }

            /* Sol Navigasyon İkonları Hover Efekti */
            .nav-item-hover {
                opacity: 0.7;
                transition: all 0.3s ease;
            }

                .nav-item-hover:hover {
                    opacity: 1;
                    text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
                    transform: translateY(-1px);
                }
    </style>
</head>
<body>

    <div class="hero-section d-flex flex-column justify-content-center">
        <!-- Header Bar -->
        <header>
            <nav class="navbar custom-navbar">
                <div class="container-fluid px-4 px-md-5 d-flex justify-content-between align-items-center">
                    <!-- Sol Taraf: Dinamik Navigasyon Menüsü -->
                    <div class="d-flex align-items-center" style="min-width: 140px;">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- Herkese Açık Dashboard İkonu -->
                         

                            <!-- Sadece Adminlere Özel Kullanıcı Yönetimi İkonu -->
                            @if (User.IsInRole("Admin") || User.IsInRole("3"))
                            {
                                <a href="/Home/Dashboard" class="text-white text-decoration-none transition-icon nav-item-hover me-4" title="Dashboard">
                                    <i class="fa-solid fa-chart-pie fa-lg me-2"></i>
                                    <span class="d-none d-md-inline small fw-bold">Dashboard</span>
                                </a>
                                
                                
                                <a href="/Admin/Index" class="text-white text-decoration-none transition-icon nav-item-hover" title="Kullanıcı Yönetimi">
                                    <i class="fa-solid fa-users-gear fa-lg me-2"></i>
                                    <span class="d-none d-md-inline small fw-bold">Kullanıcılar</span>
                                </a>
                            }
                        }
                    </div>

                    <!-- Orta Taraf: Resmi BİREVİM Logosu -->
                    <a class="brand-logo-container text-center mx-auto" href="/">
                        <img src="https://www.birevim.com/assets/img/logo-red.svg" alt="BİREVİM Logo" class="site-logo">
                    </a>

                    
                    <!-- Sağ Taraf: Profil ve Giriş/Çıkış Butonları -->
                    <div class="text-end" style="min-width: 140px;">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- Eklendi: list-style: none; margin: 0; padding: 0; -->
                            <ul class="d-flex justify-content-end align-items-center gap-3 mb-0" style="list-style: none; margin: 0; padding: 0;">

                                <!-- 1. BİLDİRİM ÇANI BURAYA EKLENDİ -->
                                @await Component.InvokeAsync("NotificationBell")

                                <!-- 2. Profil İkonu -->
                                <li>
                                    <a href="/Home/Profilim" class="text-white text-decoration-none transition-icon" title="Profilim" style="opacity: 0.8;">
                                        <i class="fa-solid fa-circle-user fa-2xl"></i>
                                    </a>
                                </li>

                                <!-- 3. Çıkış Yap Butonu -->
                                <li>
                                    <a href="/Account/Logout" class="btn btn-sm btn-outline-light rounded-pill px-3 py-2 transition-icon" style="border-color: rgba(255,255,255,0.4);">
                                        <i class="fa-solid fa-right-from-bracket me-2"></i>Çıkış Yap
                                    </a>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <!-- Giriş Yap Butonu (Sadece Ziyaretçiler Görür) -->
                            <a href="/Account/Login" class="btn-login">
                                <i class="fa-solid fa-user me-2"></i>Giriş Yap
                            </a>
                        }
                    </div>
                </div>
            </nav>
        </header>

        <!-- Sayfa İçeriği -->
        <main class="w-100 pt-5">
            @RenderBody()
        </main>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>