<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BİREVİM</title>

    <link rel="icon" type="image/webp" href="~/images/icon.webp" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
            /* --- Temel ve Form Sıfırlamaları --- */
            .form-floating > label,
            .form-floating > .form-control:focus ~ label,
            .form-floating > .form-control:not(:placeholder-shown) ~ label,
            .form-floating > .form-select ~ label {
                background-color: transparent !important;
                background: none !important;
            }

                /* Etiket kayarken arkada oluşan Bootstrap beyazlığını silme (Sorunun kaynağı buydu) */
                .form-floating > .form-control:focus ~ label::after,
                .form-floating > .form-control:not(:placeholder-shown) ~ label::after {
                    background-color: transparent !important;
                    background: none !important;
                }

            /* Tarayıcı otomatik doldurma renklerini düzeltme */
            input:-webkit-autofill, input:-webkit-autofill:hover, input:-webkit-autofill:focus, input:-webkit-autofill:active {
                -webkit-box-shadow: 0 0 0 1000px #221515 inset !important;
                -webkit-text-fill-color: #ffffff !important;
                caret-color: #ffffff !important;
                transition: background-color 50000s ease-in-out 0s;
            }

            input::-webkit-credentials-auto-fill-button, input::-webkit-contacts-auto-fill-button, input::-webkit-autofill-preview-image {
                display: none !important;
                visibility: hidden !important;
                pointer-events: none !important;
            }

            /* Ekranın Taşmasını Önleme */
            html, body {
                height: 100vh;
                margin: 0;
                padding: 0;
                overflow: hidden;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            /* Arka Plan Hero Section */
            .hero-section {
                background: linear-gradient(rgba(0,0,0,0.15), rgba(0,0,0,0.15)), url('/images/hero-bg.webp');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                height: 100vh;
                width: 100vw;
                color: #fff;
                position: relative;
            }

            /* --- ÜST MENÜ (NAVBAR) --- */
            .custom-navbar {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                z-index: 100;
                background: linear-gradient(180deg, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 100%);
                padding: 16px 0;
            }

            .site-logo {
                height: 42px;
                width: auto;
                filter: brightness(0) invert(1);
                transition: transform 0.3s ease;
            }

                .site-logo:hover {
                    transform: scale(1.05);
                }

            /* Hamburger Butonu */
            .hamburger-btn {
                background: transparent;
                border: none;
                color: white;
                font-size: 1.6rem;
                transition: transform 0.3s ease, text-shadow 0.3s ease;
                padding: 0;
            }

                .hamburger-btn:hover {
                    transform: scale(1.1);
                    text-shadow: 0 0 15px rgba(255, 255, 255, 0.8);
                }

            /* Giriş Yap Butonu */
            .btn-login {
                background-color: rgba(255, 255, 255, 0.15);
                color: #ffffff !important;
                border: 1px solid rgba(255, 255, 255, 0.4);
                padding: 8px 20px;
                border-radius: 30px;
                font-weight: 600;
                font-size: 13px;
                text-decoration: none;
                backdrop-filter: blur(5px);
                transition: all 0.3s ease;
            }

                .btn-login:hover {
                    background-color: #ffffff;
                    color: #111111 !important;
                    border-color: #ffffff;
                    box-shadow: 0 4px 15px rgba(255, 255, 255, 0.2);
                }

            /* Sağ Üst İkonlar */
            .transition-icon {
                transition: transform 0.3s ease, color 0.3s ease;
            }

                .transition-icon:hover {
                    transform: scale(1.1);
                }

            /* --- MEVCUT FORM VE CAM KART STİLLERİ --- */
            .glass-register-card {
                background: rgba(15, 15, 15, 0.45);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border: 1px solid rgba(255, 255, 255, 0.15);
                border-radius: 20px;
                box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
                transition: all 0.4s ease;
                max-width: 420px;
            }

            .form-floating > .custom-glass-input {
                background: rgba(255, 255, 255, 0.08) !important;
                border: 1px solid rgba(255, 255, 255, 0.2) !important;
                color: #fff !important;
                border-radius: 10px !important;
                height: calc(2.8rem + 2px) !important;
                line-height: 1.1 !important;
                font-size: 14px;
            }

            .form-floating > label {
                color: rgba(255, 255, 255, 0.6) !important;
                padding-top: 0.6rem !important;
                font-size: 13px;
            }

            .custom-glass-input:focus {
                background: rgba(255, 255, 255, 0.15) !important;
                border-color: #ffffff !important;
                box-shadow: 0 0 15px rgba(255, 255, 255, 0.2) !important;
            }

            .btn-glass-submit {
                background: #ffffff;
                color: #111111;
                border-radius: 10px;
                transition: all 0.3s ease;
                border: none;
            }

                .btn-glass-submit:hover {
                    background: #ffffff !important;
                    color: #e30613 !important;
                    transform: translateY(-2px);
                    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
                }

            /* --- ŞİFRE İKONU (KAYMIŞTI, DÜZELTİLDİ) --- */
            .toggle-password {
                position: absolute;
                right: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: rgba(255, 255, 255, 0.6);
                cursor: pointer;
                z-index: 10;
                transition: color 0.3s ease;
            }

                .toggle-password:hover {
                    color: #ffffff;
                }

            /* --- CUSTOM CHECKBOX (SİLİNMİŞTİ, GERİ EKLENDİ) --- */
            .custom-checkbox {
                background-color: rgba(255, 255, 255, 0.1);
                border-color: rgba(255, 255, 255, 0.3);
                cursor: pointer;
            }

                .custom-checkbox:checked {
                    background-color: #ffffff;
                    border-color: #ffffff;
                }

            /* Offcanvas Scrollbar */
            .custom-scroll::-webkit-scrollbar {
                width: 6px;
            }

            .custom-scroll::-webkit-scrollbar-track {
                background: transparent;
            }

            .custom-scroll::-webkit-scrollbar-thumb {
                background: rgba(255, 255, 255, 0.15);
                border-radius: 10px;
            }

                .custom-scroll::-webkit-scrollbar-thumb:hover {
                    background: rgba(255, 255, 255, 0.3);
                }
    </style>
</head>
<body>

    <div class="hero-section d-flex flex-column justify-content-center">
        <!-- HEADER (ÜST MENÜ) -->
        <header>
            <nav class="navbar custom-navbar navbar-expand-lg">
                <div class="container-fluid px-4 px-md-5 d-flex justify-content-between align-items-center">

                    <!-- Sol: Hamburger Butonu -->
                    <div class="d-flex align-items-center" style="min-width: 140px;">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <button class="hamburger-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
                                <i class="fa-solid fa-bars"></i>
                            </button>
                        }
                    </div>

                    <!-- Orta: Logo -->
                    <a class="brand-logo-container text-center mx-auto" href="/">
                        <img src="https://www.birevim.com/assets/img/logo-red.svg" alt="BİREVİM Logo" class="site-logo">
                    </a>

                    <!-- Sağ: Profil ve Çıkış İkonları -->
                    <div class="text-end" style="min-width: 140px;">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <ul class="d-flex justify-content-end align-items-center gap-3 mb-0" style="list-style: none; margin: 0; padding: 0;">
                                <!-- Bildirim Çanı -->
                                @await Component.InvokeAsync("NotificationBell")

                                <!-- Profil Bilgileri ve İkonu -->
                               
                                <li class="pe-3 border-end border-secondary border-opacity-50 me-2">
                                    <a href="/Home/Profilim" class="d-flex align-items-center text-white text-decoration-none transition-icon" title="Profilim" style="opacity: 0.9;">

                                        <!-- Profil İkonu (Arayı daraltmak için me-3 yerine me-2 yapıldı) -->
                                        <i class="fa-solid fa-circle-user fa-2xl me-2"></i>

                                        <!-- İsim ve Rol (Sadece geniş ekranlarda görünür) -->
                                        <div class="text-start d-none d-md-block" style="line-height: 1.2;">
                                            <div class="fw-bold" style="font-size: 0.85rem;">
                                                @User.Identity.Name
                                            </div>
                                            <div class="text-white-50" style="font-size: 0.75rem;">
                                                @(User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Kullanıcı")
                                            </div>
                                        </div>

                                    </a>
                                </li>

                                <!-- Çıkış Yap -->
                                <li>
                                    <a href="/Account/Logout" class="btn btn-sm btn-outline-light rounded-pill px-3 py-2 transition-icon" style="border-color: rgba(255,255,255,0.4);">
                                        <i class="fa-solid fa-right-from-bracket me-2"></i>Çıkış Yap
                                    </a>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <a href="/Account/Login" class="btn-login">
                                <i class="fa-solid fa-user me-2"></i>Giriş Yap
                            </a>
                        }
                    </div>
                </div>
            </nav>
        </header>

        <!-- OFFCANVAS (SOLDAN AÇILAN YENİ CAM PANEL) -->
        @if (User.Identity.IsAuthenticated)
        {
            <div class="offcanvas offcanvas-start border-0" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarMenuLabel" style="width: 290px; background: rgba(15, 15, 15, 0.45); backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px); border-right: 1px solid rgba(255, 255, 255, 0.1) !important; box-shadow: 5px 0 25px rgba(0,0,0,0.5);">
                <div class="offcanvas-header border-bottom border-secondary border-opacity-25 pb-4 mt-3 mx-4 px-0">
                    <img src="https://www.birevim.com/assets/img/logo-red.svg" alt="BİREVİM Logo" style="height: 35px; filter: brightness(0) invert(1);">
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>

                <!-- Menü Linkleri (Senin Seçtiğin Şık Tasarımla Geliyor) -->
                <div class="offcanvas-body px-3 py-4 custom-scroll">
                    @await Component.InvokeAsync("DynamicMenu")
                </div>
            </div>
        }

        <!-- ANA SAYFA İÇERİĞİ -->
        <main class="w-100 pt-5 mt-4" style="height: calc(100vh - 80px); overflow-y: auto;">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>