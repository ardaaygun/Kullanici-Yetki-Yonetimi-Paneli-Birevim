@{
    ViewData["Title"] = "Dashboard - Genel Bakış";
}

<style>
    /* Dashboard'a özel cam efektli kart sınıfımız */
    .glass-dashboard-card {
        background: rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 1.25rem;
        color: #ffffff;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        /* Üzerine gelince kartın hafifçe havaya kalkma efekti */
        .glass-dashboard-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
            border-color: rgba(255, 255, 255, 0.3);
        }

    .icon-box {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.1);
        font-size: 1.25rem;
    }

    /* İlerleme çubukları (Progress Bar) için şeffaf tema */
    .glass-progress {
        background-color: rgba(255, 255, 255, 0.1) !important;
        height: 8px !important;
        border-radius: 10px;
        overflow: hidden;
    }

    /* Birevim kırmızı tonlarına uygun gradient progress bar */
    .bg-birevim-gradient {
        background: linear-gradient(90deg, #ff4b4b 0%, #d30000 100%);
    }
</style>

<div class="container-fluid px-4 px-md-5 py-4 mt-3">

    <!-- Sayfa Başlığı -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-white mb-0">
            <i class="fa-solid fa-chart-pie me-2"></i>Dashboard
        </h3>
        <span class="text-white-50 small">Son Güncelleme: Bugün, 14:30</span>
    </div>

    <!-- ÜST KISIM: 3'LÜ İSTATİSTİK KARTLARI -->
    <div class="row g-4 mb-4">

        <!-- 1. Tüm Üretim Kartı -->
        <div class="col-12 col-md-4">
            <div class="glass-dashboard-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="text-white-50 mb-1 fw-semibold small text-uppercase">Tüm Üretim</p>
                        <h4 class="fw-bold mb-0">₺681.313.000</h4>
                    </div>
                    <div class="icon-box text-primary border border-primary border-opacity-25">
                        <i class="fa-solid fa-industry"></i>
                    </div>
                </div>
                <div class="mt-auto pt-2 border-top border-light border-opacity-10">
                    <span class="text-white-50 small">
                        <i class="fa-solid fa-bars-progress me-1"></i> <strong class="text-white">267</strong> Toplam Proje Adedi
                    </span>
                </div>
            </div>
        </div>

        <!-- 2. Yeni Üretim Kartı -->
        <div class="col-12 col-md-4">
            <div class="glass-dashboard-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="text-white-50 mb-1 fw-semibold small text-uppercase">Yeni Üretim</p>
                        <h4 class="fw-bold mb-0">₺523.378.000</h4>
                    </div>
                    <div class="icon-box text-success border border-success border-opacity-25">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                </div>
                <div class="mt-auto pt-2 border-top border-light border-opacity-10">
                    <span class="text-white-50 small">
                        <i class="fa-solid fa-file-signature me-1"></i> <strong class="text-white">223</strong> Yeni Proje Adedi
                    </span>
                </div>
            </div>
        </div>

        <!-- 3. Çalışma Bedeli Kartı -->
        <div class="col-12 col-md-4">
            <div class="glass-dashboard-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="text-white-50 mb-1 fw-semibold small text-uppercase">Çalışma Bedeli</p>
                        <h4 class="fw-bold mb-0">₺45.110.856</h4>
                    </div>
                    <div class="icon-box text-warning border border-warning border-opacity-25">
                        <i class="fa-solid fa-coins"></i>
                    </div>
                </div>
                <div class="mt-auto pt-2 border-top border-light border-opacity-10">
                    <span class="text-white-50 small">
                        <i class="fa-solid fa-percent me-1"></i> <strong class="text-white">8.06%</strong> Tüm Tahakkuk ÇB.
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- ALT KISIM: BÖLGESEL DAĞILIM (Geniş Panel) -->
    <div class="row">
        <div class="col-12">
            <div class="glass-dashboard-card p-4 p-lg-5">
                <h5 class="fw-bold mb-4 border-bottom border-light border-opacity-10 pb-3">
                    <i class="fa-solid fa-map-location-dot me-2"></i>Üretim Tutarı Bölgesel Dağılım
                </h5>

                <div class="row mt-4">
                    <!-- Sol Sütun: Marmara ve Ege -->
                    <div class="col-12 col-md-6 pe-md-4">

                        <div class="mb-4">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-semibold text-white">Marmara Bölgesi</span>
                                <span class="text-white-50">₺310.500.000 (45%)</span>
                            </div>
                            <div class="progress glass-progress">
                                <div class="progress-bar bg-birevim-gradient" role="progressbar" style="width: 45%;" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-semibold text-white">Ege Bölgesi</span>
                                <span class="text-white-50">₺115.820.000 (17%)</span>
                            </div>
                            <div class="progress glass-progress">
                                <div class="progress-bar bg-birevim-gradient" role="progressbar" style="width: 17%;" aria-valuenow="17" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>

                    </div>

                    <!-- Sağ Sütun: İç Anadolu ve Diğer Bölgeler -->
                    <div class="col-12 col-md-6 ps-md-4 border-start border-light border-opacity-10">

                        <div class="mb-4">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-semibold text-white">İç Anadolu Bölgesi</span>
                                <span class="text-white-50">₺180.200.000 (26%)</span>
                            </div>
                            <div class="progress glass-progress">
                                <div class="progress-bar bg-birevim-gradient" role="progressbar" style="width: 26%;" aria-valuenow="26" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-semibold text-white">Diğer Bölgeler</span>
                                <span class="text-white-50">₺74.793.000 (12%)</span>
                            </div>
                            <div class="progress glass-progress">
                                <div class="progress-bar bg-birevim-gradient" role="progressbar" style="width: 12%;" aria-valuenow="12" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

</div>