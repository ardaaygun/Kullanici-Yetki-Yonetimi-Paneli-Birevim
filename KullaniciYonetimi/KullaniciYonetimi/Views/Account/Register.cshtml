@model KullaniciYonetimi.Models.ViewModels.RegisterViewModel
@{
    Layout = null; // Veya kullandığın özel bir layout varsa onun yolu
    ViewData["Title"] = "Hesap Oluştur";
}

<!-- Tasarımının olduğu ana kapsayıcı (container / card) -->
<form id="registerForm" action="/Account/Register" method="post" autocomplete="off">

    <!-- Ad & Soyad -->
    <div class="row g-2 mb-3">
        <div class="col-6">
            <input type="text" name="FirstName" class="form-control" placeholder="Ad" required>
        </div>
        <div class="col-6">
            <input type="text" name="LastName" class="form-control" placeholder="Soyad" required>
        </div>
    </div>

    <!-- E-Posta Adresi -->
    <div class="mb-3">
        <input type="email" name="Email" class="form-control" placeholder="E-Posta Adresi" required>
    </div>

    <!-- Telefon Numarası -->
    <div class="mb-3">
        <input type="tel" name="PhoneNumber" class="form-control" placeholder="Telefon Numarası" required>
    </div>

    <!-- Şifre -->
    <div class="mb-3">
        <input type="password" id="pass" name="Password" class="form-control" placeholder="Şifre" required>
    </div>

    <!-- Şifre Tekrar -->
    <div class="mb-3">
        <input type="password" id="confirmPass" name="ConfirmPassword" class="form-control" placeholder="Şifre Tekrar" required>
    </div>

    <!-- Kullanım Koşulları Checkbox -->
    <div class="form-check mb-4">
        <input class="form-check-input" type="checkbox" id="terms" name="IsTermsAccepted" value="true" required>
        <label class="form-check-label text-white-50 small" for="terms">
            Kullanım koşullarını ve gizlilik politikasını kabul ediyorum.
        </label>
    </div>

    <!-- Hesabımı Oluştur Butonu -->
    <button type="submit" id="btnRegister" class="btn btn-light w-100 py-3 fw-bold rounded-3 d-flex align-items-center justify-content-center gap-2">
        <span>Hesabımı Oluştur</span>
        <i class="fa-solid fa-arrow-right"></i>
    </button>
</form>

<!-- Tıklama Anı ve Ön Kontrol Script'i -->
<script>
    document.getElementById("registerForm").addEventListener("submit", function(e) {
        const pass = document.getElementById("pass").value;
        const confirmPass = document.getElementById("confirmPass").value;
        const terms = document.getElementById("terms").checked;
        const btn = document.getElementById("btnRegister");

        // Şifreler uyuşuyor mu?
        if (pass !== confirmPass) {
            e.preventDefault();
            alert("Girdiğiniz şifreler birbiriyle eşleşmiyor!");
            return;
        }

        // Sözleşme kutusu işaretli mi?
        if (!terms) {
            e.preventDefault();
            alert("Lütfen kullanım koşullarını kabul edin.");
            return;
        }

        // Buton Yükleniyor (Loading) Durumu
        btn.disabled = true;
        btn.innerHTML = `
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span>Hesap Oluşturuluyor...</span>
        `;
    });
</script>