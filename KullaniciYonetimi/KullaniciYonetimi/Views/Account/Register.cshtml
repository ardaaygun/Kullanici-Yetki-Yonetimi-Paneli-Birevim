@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-white mb-1">Kullanıcı Yönetimi</h3>
        <p class="text-white-50 small m-0">Sistemde kayıtlı kullanıcıları ve yetkilerini buradan yönetebilirsiniz.</p>
    </div>
    <button class="btn btn-danger px-4 py-2 fw-semibold rounded-3" data-bs-toggle="modal" data-bs-target="#addUserModal">
        <i class="fa-solid fa-user-plus me-2"></i>Yeni Kullanıcı Ekle
    </button>
</div>

<!-- Kullanıcı Listesi Tablo Kartı -->
<div class="glass-card p-4">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle m-0 bg-transparent">
            <thead>
                <tr class="text-white-50 border-bottom border-secondary">
                    <th>Kullanıcı Bilgisi</th>
                    <th>E-Posta</th>
                    <th>Rol</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                <!-- Örnek Kullanıcı 1 -->
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-danger text-white d-flex align-items-center justify-content-center fw-bold rounded-circle" style="width: 40px; height: 40px;">
                                A
                            </div>
                            <span class="fw-semibold text-white">Ahmet Yılmaz</span>
                        </div>
                    </td>
                    <td class="text-white-50">ahmet.yilmaz@birevim.com</td>
                    <td>
                        <span class="badge bg-danger px-3 py-2 rounded-pill">Admin</span>
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-light me-1" title="Düzenle">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" title="Sil">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>

                <!-- Örnek Kullanıcı 2 -->
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-primary text-white d-flex align-items-center justify-content-center fw-bold rounded-circle" style="width: 40px; height: 40px;">
                                M
                            </div>
                            <span class="fw-semibold text-white">Mehmet Demir</span>
                        </div>
                    </td>
                    <td class="text-white-50">mehmet.demir@birevim.com</td>
                    <td>
                        <span class="badge bg-primary px-3 py-2 rounded-pill">Yönetici</span>
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-light me-1" title="Düzenle">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" title="Sil">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>

                <!-- Örnek Kullanıcı 3 -->
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center fw-bold rounded-circle" style="width: 40px; height: 40px;">
                                A
                            </div>
                            <span class="fw-semibold text-white">Ayşe Kaya</span>
                        </div>
                    </td>
                    <td class="text-white-50">ayse.kaya@birevim.com</td>
                    <td>
                        <span class="badge bg-secondary px-3 py-2 rounded-pill">Kullanıcı</span>
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-light me-1" title="Düzenle">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" title="Sil">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Yeni Kullanıcı Ekleme Modali (Popup) -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold">Yeni Kullanıcı Ekle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addUserForm">
                    <div class="mb-3">
                        <label class="form-label text-white-50">Ad Soyad</label>
                        <input type="text" class="form-control bg-transparent text-white border-secondary" placeholder="Örn: Ahmet Yılmaz" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50">E-Posta Adresi</label>
                        <input type="email" class="form-control bg-transparent text-white border-secondary" placeholder="ahmet@example.com" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50">Kullanıcı Rolü</label>
                        <select class="form-select bg-dark text-white border-secondary">
                            <option value="Kullanıcı">Kullanıcı</option>
                            <option value="Yönetici">Yönetici</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-danger">Kullanıcıyı Kaydet</button>
            </div>
        </div>
    </div>
</div>