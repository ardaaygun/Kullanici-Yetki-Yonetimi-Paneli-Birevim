@model List<KullaniciYonetimi.ViewModels.UserViewModel>

<h2>Yönetim Paneli - Kullanıcı Listesi</h2>

<table border="1" cellpadding="10">
    <thead>
        <tr>
            <th>Ad Soyad</th>
            <th>E-posta</th>
            <th>Mevcut Rolü</th>
            <th>İşlem</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td><strong>@user.RoleName</strong></td>
                <td>
                    @* Her kullanıcının yanına özel bir mini form açıyoruz *@
                    <form asp-controller="Admin" asp-action="YetkiDegistir" method="post" style="display:inline;">

                        @* Arka plana gidecek olan kullaniciId'yi gizli (hidden) olarak tutuyoruz *@
                        <input type="hidden" name="kullaniciId" value="@user.Id" />

                        @* Admin'in yeni rolü seçebilmesi için açılır menü (Select) yapıyoruz *@
                        <select name="yeniRolId" required>
                            <option value="">Seçiniz...</option>
                            <option value="1">Standart</option>
                            <option value="2">Yönetici</option>
                            <option value="3">Admin</option>
                        </select>

                        <button type="submit">Güncelle</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>