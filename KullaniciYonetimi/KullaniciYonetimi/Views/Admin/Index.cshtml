@model List<KullaniciYonetimi.Models.ViewModels.UserViewModel>
@{
    ViewData["Title"] = "Kullanıcı Listesi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-white mb-1">Kullanıcı Yönetimi</h3>
        <p class="text-white-50 small m-0">Sistemde kayıtlı kullanıcıları ve yetkilerini buradan yönetebilirsiniz.</p>
    </div>
    <a href="/Account/Register" class="btn btn-danger px-4 py-2 fw-semibold">
        <i class="fa-solid fa-plus me-2"></i>Yeni Kullanıcı Ekle
    </a>
</div>

<!-- Kullanıcı Listesi Tablo Kartı -->
<div class="glass-card p-4">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle m-0">
            <thead>
                <tr class="text-white-50 border-bottom border-secondary">
                    <th>Kullanıcı Bilgisi</th>
                    <th>E-Posta</th>
                    <th>Rol</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        <tr>
                            <!-- Ad Soyad -->
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold rounded-circle" style="width: 40px; height: 40px;">
                                        @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <span class="fw-semibold text-white">@user.FullName</span>
                                </div>
                            </td>

                            <!-- E-Posta -->
                            <td class="text-white-50">@user.Email</td>

                            <!-- Rol (Badge) -->
                            <td>
                                @if (user.RoleName == "Admin")
                                {
                                    <span class="badge bg-danger px-3 py-2">Admin</span>
                                }
                                else if (user.RoleName == "Yönetici")
                                {
                                    <span class="badge bg-primary px-3 py-2">Yönetici</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">Kullanıcı</span>
                                }
                            </td>

                            <!-- İşlemler -->
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-light me-1" title="Düzenle">
                                    <i class="fa-solid fa-pen"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" title="Sil">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-white-50">
                            Henüz kayıtlı bir kullanıcı bulunmuyor.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>