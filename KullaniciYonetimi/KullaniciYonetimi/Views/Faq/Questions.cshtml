@model IEnumerable<KullaniciYonetimi.Models.Faq>

@{
    ViewData["Title"] = ViewBag.CategoryName + " - Sorular";
}

<style>
    .glass-table {
        --bs-table-bg: transparent;
        --bs-table-color: white;
        --bs-table-border-color: rgba(255, 255, 255, 0.15);
    }

        .glass-table th,
        .glass-table td {
            background-color: transparent !important;
            color: #ffffff !important;
            vertical-align: middle;
        }
</style>

<div class="container-fluid px-4 px-md-5 my-auto py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 mt-4">
            <div class="glass-register-card p-4 p-lg-5 w-100" style="max-width: 100% !important;">

                <!-- Başlık ve Yönlendirme Butonları -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold text-white mb-0">
                        <i class="fa-solid fa-circle-question me-2"></i>@ViewBag.CategoryName - Sorular
                    </h3>
                    <div>
                        <a href="/Faq/Index" class="btn btn-outline-secondary transition-icon me-2 text-white border-white">
                            <i class="fa-solid fa-arrow-left me-1"></i> Kategorilere Dön
                        </a>

                        <!-- Yeni Soru Ekleme Butonu (Hangi kategoriye eklediğimizi QueryString ile yolluyoruz) -->
                        <a href="/Faq/CreateQuestion?categoryId=@ViewBag.CategoryId" class="btn btn-outline-light transition-icon">
                            <i class="fa-solid fa-plus me-1"></i> Yeni Soru Ekle
                        </a>
                    </div>
                </div>

                <!-- Şeffaf Cam Efektli Tablo -->
                <div class="table-responsive">
                    <table class="table glass-table mb-0">
                        <thead>
                            <tr>
                                <th class="fw-semibold">Sıra</th>
                                <th class="fw-semibold">Soru</th>
                                <th class="fw-semibold text-center">Görüntülenme</th>
                                <th class="fw-semibold text-center">Durum</th>
                                <th class="text-end fw-semibold">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                /* Soru listesini Rank (Sıralama) değerine göre küçükten büyüğe sıralayarak döneriz */
                                foreach (var soru in Model.OrderBy(s => s.Rank))
                                {
                                    <tr>
                                        <td><span class="badge bg-dark bg-opacity-50 border border-light border-opacity-25">@soru.Rank</span></td>
                                        <td>@soru.Question</td>
                                        <td class="text-center">@soru.ViewNumber</td>
                                        <td class="text-center">
                                            @if (soru.IsActive)
                                            {
                                                <span class="badge bg-success bg-opacity-75 border border-light border-opacity-25 py-2 px-3 fw-normal">Aktif</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-75 border border-light border-opacity-25 py-2 px-3 fw-normal">Pasif</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end align-items-center gap-2">
                                                <!-- Soru Düzenle -->
                                                <a href="/Faq/EditQuestion/@soru.Id" class="btn btn-sm btn-outline-warning transition-icon" title="Düzenle">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </a>
                                                <!-- Soru Sil -->
                                                <form action="/Faq/DeleteQuestion" method="post" class="m-0" onsubmit="return confirm('Bu soruyu silmek istediğinize emin misiniz?');">
                                                    <input type="hidden" name="id" value="@soru.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger transition-icon" title="Soruyu Sil">
                                                        <i class="fa-solid fa-trash-can"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-white-50 border-0">Bu kategoriye henüz soru eklenmemiş.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>