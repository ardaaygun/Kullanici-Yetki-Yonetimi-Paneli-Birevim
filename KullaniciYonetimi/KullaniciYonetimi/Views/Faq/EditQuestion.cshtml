@model KullaniciYonetimi.Models.Faq

@{
    ViewData["Title"] = "Soru Düzenle";
}

<style>
    .glass-input {
        background-color: rgba(0, 0, 0, 0.4) !important;
        color: white !important;
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
    }

        .glass-input:focus {
            box-shadow: 0 0 0 0.25rem rgba(255, 255, 255, 0.1);
            border-color: white !important;
        }

    .glass-check-input {
        background-color: rgba(255, 255, 255, 0.2);
        border-color: rgba(255, 255, 255, 0.5);
    }

        .glass-check-input:checked {
            background-color: #198754;
            border-color: #198754;
        }
</style>

<div class="container-fluid px-4 px-md-5 my-auto py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 mt-4">

            <div class="glass-register-card p-4 p-lg-5 w-100">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold text-white mb-0">
                        <i class="fa-solid fa-pen-to-square me-2"></i>Soru Düzenle
                    </h4>
                    <a href="/Faq/Questions?categoryId=@ViewBag.CategoryId" class="btn btn-sm btn-outline-light transition-icon">
                        <i class="fa-solid fa-arrow-left me-1"></i> İptal
                    </a>
                </div>

                <!-- SORU DÜZENLEME FORMU -->
                <form asp-controller="Faq" asp-action="EditQuestion" method="post">

                    <!-- DİKKAT: Güncelleme işlemi için bu 3 değer formda gizli olarak bulunmak zorundadır -->
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CategoryId" />
                    <input type="hidden" asp-for="ViewNumber" />

                    <div class="mb-4">
                        <label class="form-label text-white-50">Soru</label>
                        <input type="text" asp-for="Question" class="form-control glass-input" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-white-50">Cevap</label>
                        <textarea asp-for="Answer" class="form-control glass-input" rows="4" required></textarea>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label class="form-label text-white-50">Sıralama (Rank)</label>
                            <input type="number" asp-for="Rank" class="form-control glass-input" required />
                        </div>

                        <div class="col-md-6 d-flex align-items-center mt-md-4">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input glass-check-input" type="checkbox" role="switch" asp-for="IsActive">
                                <label class="form-check-label text-white ms-2" for="IsActive">Soru Aktif Olsun</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid mt-5">
                        <button type="submit" class="btn btn-warning fw-bold py-2 text-dark">
                            <i class="fa-solid fa-arrows-rotate me-2"></i>Değişiklikleri Kaydet
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>